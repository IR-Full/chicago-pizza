[Unit]
Description=Chicago Pizza encrypted off-server backup
Wants=network-online.target
After=network-online.target docker.service
OnFailure=chicago-backup-failure.service

[Service]
Type=oneshot
EnvironmentFile=/etc/chicago-backup/backup.env
ExecStart=/usr/local/lib/chicago-backup/backup-production.sh
TimeoutStartSec=45min
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
