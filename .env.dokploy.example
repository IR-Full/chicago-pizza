# Paste into Dokploy Environment. Never commit live credentials.
DOMAIN=pizza.example.ru
SERVER_IMAGE=ghcr.io/YOUR_OWNER/chicago-pizza-server:COMMIT_SHA
CLIENT_IMAGE=ghcr.io/YOUR_OWNER/chicago-pizza-client:COMMIT_SHA
POSTGRES_USER=pizza
POSTGRES_DB=chicago_pizza
# Generate each independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=pizza
RABBITMQ_PASSWORD=
JWT_ACCESS_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.ru
# Initial seed only; remove password immediately after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
