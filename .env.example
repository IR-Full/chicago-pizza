# ── Copy to .env before running docker compose ────────────────────
# cp .env.example .env

# ── Secrets (REQUIRED — compose refuses to start without them) ────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_to_a_random_32_byte_hex_string

# ── Build & seeding ───────────────────────────────────────────────
# Names the service-worker cache. CI pins it to the commit sha; leave empty
# locally and the client generates a throwaway id per build.
BUILD_ID=
# The seed upserts, so re-running it reverts prices changed in the admin
# panel. Turn it on for a fresh database, then turn it back off.
SEED_ON_START=false

# ── Database ──────────────────────────────────────────────────────
POSTGRES_USER=pizza
POSTGRES_PASSWORD=pizza

# Redis. Used for the cart, the catalogue cache, rate-limit counters and the
# session denylist — so losing it logs everyone out and empties every basket.
# Change this for anything that is not a laptop.
REDIS_PASSWORD=pizza
POSTGRES_DB=chicago_pizza
POSTGRES_PORT=5432

# Postgres tuning. The defaults suit a ~2GB host; the usual rule is
# shared_buffers ≈ 25% of RAM and effective_cache_size ≈ 75%.
#
# Do not lower max_connections below ~80: the six services cap themselves at
# 8 connections each (see `connection_limit` in docker-compose.yml), and the
# rest is headroom for the migration job and a psql session.
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB

# ── Container resource limits ──────────────────────────────────────
# Per-container ceilings, so one leaking service cannot take the host (and
# Postgres with it). The gateway and the Next.js client serve requests and get
# more; the broker-only services get less.
NODE_MEMORY_LIMIT=512M
NODE_CPU_LIMIT=1.0
GATEWAY_MEMORY_LIMIT=768M
GATEWAY_CPU_LIMIT=2.0

# ── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_USER=pizza
RABBITMQ_PASSWORD=pizza
RABBITMQ_MANAGEMENT_PORT=15672

# ── Tokens ────────────────────────────────────────────────────────
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Time ──────────────────────────────────────────────────────────
# The pizzeria's clock. Opening hours are enforced against this, not against
# the container's UTC.
TZ=Europe/Moscow

# ── TLS / reverse proxy ───────────────────────────────────────────
# Which nginx front end to mount. `nginx.conf` is plain HTTP (local, CI);
# `nginx.tls.conf` terminates TLS, redirects port 80 and sends HSTS.
# Switching it also means switching the URLs below to https://.
NGINX_CONF=nginx.conf
# Certificate directory name for the TLS config; irrelevant on plain HTTP.
DOMAIN=localhost
# Requests per second per IP that nginx accepts on /api/ (burst 20 on top of
# it), in front of the app's own throttler. One page here makes seven or eight
# API calls, so leave room: the end-to-end job raises this because a single
# machine driving the whole checkout looks like abuse to a per-IP counter.
API_RATE_LIMIT=10

# ── Public URLs ───────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
CLIENT_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=http://localhost
# The site's own public address. Canonical links, sitemap.xml and the
# structured data all have to name it absolutely — a canonical pointing at
# localhost is worse than none, so set this to the real domain before deploy.
NEXT_PUBLIC_SITE_URL=http://localhost

# ── Онлайн-оплата (optional) ─────────────────────────────────────────────
# ЮKassa: банковская карта онлайн. Без ключей кнопка недоступна, чекаут
# отклоняет онлайн-оплату, и остаётся оплата при получении — магазин без эквайринга работает
# как раньше.
#
# Вебхук провайдера настраивается на POST https://<домен>/api/payments/webhook
# Тело уведомления источником истины не считается: сервер перечитывает платёж
# по API, поэтому подделать оплату запросом на этот адрес нельзя.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPT_ENABLED=false
# Set explicitly with your accountant / cash-register provider before enabling receipts.
# VAT codes 1..12; tax system codes 1..6. See PAYMENTS_YOOKASSA.md.
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=

# ── Карта (optional) ─────────────────────────────────────────────────────
# 2GIS MapGL key. Without it the address form stays exactly as it is — typed,
# with no pin — and the CSP keeps its tighter policy instead of carrying holes
# for a map nobody loads. Delivery zones need the coordinates a pin provides.
#
#   https://dev.2gis.ru/ → Ключи → MapGL JS API
NEXT_PUBLIC_2GIS_MAP_KEY=

# ── Web Push (optional) ──────────────────────────────────────────────────
# Browser notifications for order status. Leave empty and the feature stays
# switched off: the toggle is not offered, and email plus the in-app bell
# carry on unchanged.
#
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chicago-pizza.ru
# Leave empty for localhost; set to your domain in production (e.g. .chicago-pizza.ru)
COOKIE_DOMAIN=
# Marks auth cookies Secure. Left empty it is inferred from CLIENT_URL
# (https:// => true), which is correct for both localhost and a TLS domain.
# Set to true explicitly if TLS is terminated by an upstream load balancer.
COOKIE_SECURE=

# ── API docs ──────────────────────────────────────────────────────
# Swagger mounts outside the Nest guards, so in production it would publish
# the whole API surface. Set to true only for a staging environment.
ENABLE_API_DOCS=false

# ── Rate limiting ─────────────────────────────────────────────────
THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60

# ── Email ─────────────────────────────────────────────────────────
# Defaults point at the bundled MailHog container, which only starts under
# the `dev` profile: `docker compose --profile dev up`.
# For production, swap in real SMTP credentials.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Chicago Pizza <no-reply@chicago-pizza.ru>
MAILHOG_UI_PORT=8025
